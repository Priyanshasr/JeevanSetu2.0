# ============================================================
# JeevanSetu 2.0 — Environment Variables Template
# Copy this to .env and fill in your values
# ============================================================

# TinyFish API
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# Backend Security
SECRET_KEY=your-secret-key-min-32-chars-here-change-in-production

# Database
DATABASE_URL=sqlite:///./jeevansetu.db
# For production Supabase:
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Supabase (for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (set in frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=JeevanSetu 2.0
VITE_ENVIRONMENT=development
