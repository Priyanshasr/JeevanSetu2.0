# ============================================================
# JeevanSetu 2.0 — .gitignore
# ============================================================

# ---- SECRETS (NEVER COMMIT) ----
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---- Python Backend ----
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.venv/
backend/venv/
backend/env/
backend/.env
backend/*.db
backend/*.sqlite3
backend/uploads/
backend/logs/
backend/*.egg-info/
backend/dist/
backend/build/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage

# ---- React Frontend ----
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
frontend/.vite/
frontend/coverage/

# ---- Database ----
*.db
*.sqlite
*.sqlite3
jeevansetu.db

# ---- Uploads & Private Files ----
uploads/
private/
medical_records/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- IDEs ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*

# ---- Misc ----
.cache/
tmp/
temp/
